# ─────────────────────────────────────────────────────────────────────────────
# Nexa Commerce — environment configuration
# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   docker compose run --rm api python -m app.cli gen-keys
# Everything else (texts, payment methods, features, branding…) is configured
# in the dashboard and stored in the database.
# ─────────────────────────────────────────────────────────────────────────────

# Public domain (Caddy obtains HTTPS certificates automatically)
DOMAIN=shop.example.com
ACME_EMAIL=you@example.com
PUBLIC_URL=https://shop.example.com
CORS_ORIGINS=https://shop.example.com

ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true

# Security — REQUIRED in production
SECRET_KEY=change-me-to-a-64-char-random-string
ENCRYPTION_KEY=change-me-fernet-key-from-gen-keys
COOKIE_SECURE=true

# Database
POSTGRES_USER=nexa
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=nexa

# Telegram
BOT_TOKEN=123456789:replace-with-token-from-BotFather
# webhook (production) | polling (no public HTTPS)
BOT_MODE=webhook
TELEGRAM_WEBHOOK_URL=https://shop.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=change-me-random-webhook-secret

# Optional: public base URL for payment provider webhooks (defaults to PUBLIC_URL)
# PAYMENT_WEBHOOK_BASE_URL=https://shop.example.com

# Optional: e-mail for password resets and notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Nexa Store <no-reply@example.com>

# Tuning
API_WORKERS=2
API_RATE_LIMIT_PER_MINUTE=300
SESSION_TTL_HOURS=168
