{
  "name": "zhihe-v2",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typegen": "wrangler types --strict-vars=false && react-router typegen",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:build": "node ./scripts/build-seed.mjs",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./seed/seed.sql",
    "admin:hash": "node ./scripts/hash-password.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
