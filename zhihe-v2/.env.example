# ZHIHE AI — environment reference.
#
# Local development: copy this file to `.dev.vars` (never commit it).
# Production: set plain variables in wrangler.jsonc → "vars" and every
# secret with `npx wrangler secret put <NAME>` (or in the Cloudflare dashboard).

# ── Plain variables (wrangler.jsonc "vars") ───────────────────────────────
# Public origin of the store, used for canonical URLs, sitemap, order links and the webhook URL.
SITE_URL=http://localhost:5173
# "mainnet" for real payments, "testnet" for @CryptoTestnetBot.
CRYPTOBOT_NETWORK=testnet
# How long an unpaid CryptoBot order keeps its stock reserved (minutes).
ORDER_TTL_MINUTES=60
# How long an unpaid manual-transfer order keeps its stock reserved (hours).
MANUAL_ORDER_TTL_HOURS=24

# ── Secrets (wrangler secret put) ─────────────────────────────────────────
# REQUIRED. Signs private order links. 32+ random characters. Changing it invalidates existing links.
# Generate: openssl rand -base64 48
ORDER_LINK_SECRET=

# REQUIRED for first run. Allows creating the owner account at /admin/setup (16+ chars).
# You can delete this secret after the owner account exists.
ADMIN_SETUP_TOKEN=

# CryptoBot / Crypto Pay API token (from @CryptoBot → Crypto Pay → My Apps).
CRYPTOBOT_API_TOKEN=

# Telegram admin notifications (from @BotFather) and the chat that receives them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional transactional email via Resend (order links, delivery notices, lost-link recovery).
RESEND_API_KEY=
# e.g. "ZHIHE AI <orders@zhihe.cyou>" — the domain must be verified in Resend.
EMAIL_FROM=
